<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" Width="1000" Height="680" Background="#F3F0FA">
    <Grid.Resources>
        <Storyboard x:Key="Entrance" Duration="0:00:02.5">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FeatureCard" Storyboard.TargetProperty="Opacity" Duration="0:00:02.5">
                <LinearDoubleKeyFrame KeyTime="0:00:00" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:00:01.2" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FeatureCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:00:02.5">
                <LinearDoubleKeyFrame KeyTime="0:00:00" Value="60" />
                <EasingDoubleKeyFrame KeyTime="0:00:01.2" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <ColorAnimation Storyboard.TargetName="AccentShape" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" From="#7953E8" To="#42B8A5" Duration="0:00:02.5" />
        </Storyboard>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#7953E8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="22,10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6340C8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Grid.Resources>
    <Grid.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard x:Name="BeginEntrance" Storyboard="{StaticResource Entrance}" />
        </EventTrigger>
    </Grid.Triggers>
    <StackPanel Margin="64,46">
        <TextBlock Text="MOTION LAB" FontSize="12" FontWeight="SemiBold" Foreground="#8066A9" />
        <TextBlock Text="Design how it feels." FontSize="38" FontWeight="Bold" Margin="0,12,0,8" Foreground="#292238" />
        <TextBlock Text="Scrub a Storyboard. Shape a curve. Bring a control to life." Foreground="#81778E" FontSize="15" Margin="0,0,0,32" />
        <Border x:Name="FeatureCard" Padding="30" CornerRadius="20" Background="White" Height="296">
            <Border.RenderTransform>
                <TranslateTransform Y="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#250E1630" ShadowDepth="8" BlurRadius="26" Direction="270" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path x:Name="AccentShape" Data="M20,120 C0,55 70,0 125,25 C180,50 140,140 95,145 Z" Width="160" Height="160" Fill="#7953E8" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="24,12,0,0">
                    <TextBlock Text="A little motion. A lot of meaning." FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Authored as human-readable WPF XAML." Foreground="#847A91" Margin="0,12,0,22" TextWrapping="Wrap" />
                    <Button x:Name="Replay" Content="Replay entrance" Style="{StaticResource ActionButton}" HorizontalAlignment="Left">
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard Storyboard="{StaticResource Entrance}" />
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>
                    <TextBlock Text="Hover this button to see its style trigger." Foreground="#9B90A7" FontSize="11" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="StateCard" Margin="0,20,0,0" Padding="18" CornerRadius="12" Background="#E8E0F7" Opacity="1">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="StateCard" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:00:00" />
                        </Storyboard>
                    </VisualState>
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:00:00.25" />
                    </VisualStateGroup.Transitions>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <TextBlock Text="Hover here: visual states transition between Normal and MouseOver." FontSize="13" Foreground="#76608D" />
        </Border>
    </StackPanel>
</Grid>
