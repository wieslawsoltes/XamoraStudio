{
  "name": "xamora-studio",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Extensible visual XAML and HTML design studio",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build-packages.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:package": "npm run build && node scripts/package-test.mjs",
    "pack:packages": "node scripts/package-release.mjs pack",
    "release:check": "node scripts/package-release.mjs check",
    "release:dry-run": "node scripts/package-release.mjs dry-run",
    "version:packages": "node scripts/package-version.mjs",
    "release:verify": "node scripts/package-release.mjs verify",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "start:ai": "node scripts/serve-ai.mjs",
    "test:jev:live": "node scripts/jev-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "20.14.3",
    "playwright": "1.62.1",
    "prettier": "3.9.0",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
