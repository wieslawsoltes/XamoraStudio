{
  "name": "@wieslawsoltes/xamora-docking",
  "version": "0.8.0",
  "description": "Standalone docking layout model and live-DOM workspace control",
  "type": "module",
  "license": "MIT",
  "author": "Xamora contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/XamoraStudio.git",
    "directory": "packages/docking"
  },
  "homepage": "https://wieslawsoltes.github.io/XamoraStudio/",
  "bugs": "https://github.com/wieslawsoltes/XamoraStudio/issues",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./docking": {
      "import": {
        "types": "./dist/esm/docking.d.ts",
        "default": "./dist/esm/docking.js"
      },
      "require": {
        "types": "./dist/cjs/docking.d.cts",
        "default": "./dist/cjs/docking.cjs"
      }
    },
    "./dock-workspace": {
      "import": {
        "types": "./dist/esm/dock-workspace.d.ts",
        "default": "./dist/esm/dock-workspace.js"
      },
      "require": {
        "types": "./dist/cjs/dock-workspace.d.cts",
        "default": "./dist/cjs/dock-workspace.cjs"
      }
    },
    "./docking.css": "./dist/assets/docking.css",
    "./scroll-buttons.css": "./dist/assets/scroll-buttons.css",
    "./browser": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/browser/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "node ../../scripts/build-packages.mjs"
  },
  "dependencies": {
    "@wieslawsoltes/xamora-control-primitives": "0.8.0"
  }
}
