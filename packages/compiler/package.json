{
  "name": "@wieslawsoltes/xamora-compiler",
  "version": "0.8.0",
  "description": "Bidirectional semantic XAML and HTML compiler with document, folder, and solution conversion",
  "type": "module",
  "license": "MIT",
  "author": "Xamora contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/XamoraStudio.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://wieslawsoltes.github.io/XamoraStudio/",
  "bugs": "https://github.com/wieslawsoltes/XamoraStudio/issues",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./semantic-compiler": {
      "import": {
        "types": "./dist/esm/semantic-compiler.d.ts",
        "default": "./dist/esm/semantic-compiler.js"
      },
      "require": {
        "types": "./dist/cjs/semantic-compiler.d.cts",
        "default": "./dist/cjs/semantic-compiler.cjs"
      }
    },
    "./conversion-project": {
      "import": {
        "types": "./dist/esm/conversion-project.d.ts",
        "default": "./dist/esm/conversion-project.js"
      },
      "require": {
        "types": "./dist/cjs/conversion-project.d.cts",
        "default": "./dist/cjs/conversion-project.cjs"
      }
    },
    "./compiler-css": {
      "import": {
        "types": "./dist/esm/compiler-css.d.ts",
        "default": "./dist/esm/compiler-css.js"
      },
      "require": {
        "types": "./dist/cjs/compiler-css.d.cts",
        "default": "./dist/cjs/compiler-css.cjs"
      }
    },
    "./compiler-native": {
      "import": {
        "types": "./dist/esm/compiler-native.d.ts",
        "default": "./dist/esm/compiler-native.js"
      },
      "require": {
        "types": "./dist/cjs/compiler-native.d.cts",
        "default": "./dist/cjs/compiler-native.cjs"
      }
    },
    "./compiler-browser": {
      "import": {
        "types": "./dist/esm/compiler-browser.d.ts",
        "default": "./dist/esm/compiler-browser.js"
      },
      "require": {
        "types": "./dist/cjs/compiler-browser.d.cts",
        "default": "./dist/cjs/compiler-browser.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "node ../../scripts/build-packages.mjs"
  },
  "dependencies": {
    "@wieslawsoltes/xamora-animation": "0.8.0",
    "@wieslawsoltes/xamora-contracts": "0.8.0",
    "@wieslawsoltes/xamora-designer": "0.8.0",
    "@wieslawsoltes/xamora-markup": "0.8.0",
    "@wieslawsoltes/xamora-model": "0.8.0",
    "@wieslawsoltes/xamora-styling": "0.8.0",
    "happy-dom": "^20.14.3"
  },
  "bin": {
    "xamora-convert": "./dist/esm/cli/index.js"
  },
  "xamora": {
    "modules": [
      "semantic-compiler",
      "conversion-project",
      "compiler-css",
      "compiler-native",
      "compiler-browser"
    ],
    "cli": "dist/compiler-cli/index.js",
    "cliModules": [
      "assets",
      "stylesheets"
    ]
  }
}
