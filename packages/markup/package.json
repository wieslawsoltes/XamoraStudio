        "types": "./dist/cjs/markup-refactoring.d.cts",
        "default": "./dist/cjs/markup-refactoring.cjs"
      }
    },
    "./source-text-coordinates": {
      "import": {
        "types": "./dist/esm/source-text-coordinates.d.ts",
