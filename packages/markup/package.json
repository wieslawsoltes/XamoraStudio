      "require": {
        "types": "./dist/cjs/source-text-coordinates.d.cts",
        "default": "./dist/cjs/source-text-coordinates.cjs"
      }
    },
    "./markup-structure": {
      "import": {
        "types": "./dist/esm/markup-structure.d.ts",
