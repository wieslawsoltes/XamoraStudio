{
  "name": "@wieslawsoltes/xamora-markup",
  "version": "0.8.0",
  "description": "XAML and HTML parsing, source synchronization, language services, and CSS motion",
  "type": "module",
  "license": "MIT",
  "author": "Xamora contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/XamoraStudio.git",
    "directory": "packages/markup"
  },
  "homepage": "https://wieslawsoltes.github.io/XamoraStudio/",
  "bugs": "https://github.com/wieslawsoltes/XamoraStudio/issues",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./xaml": {
      "import": {
        "types": "./dist/esm/xaml.d.ts",
        "default": "./dist/esm/xaml.js"
      },
      "require": {
        "types": "./dist/cjs/xaml.d.cts",
        "default": "./dist/cjs/xaml.cjs"
      }
    },
    "./html": {
      "import": {
        "types": "./dist/esm/html.d.ts",
        "default": "./dist/esm/html.js"
      },
      "require": {
        "types": "./dist/cjs/html.d.cts",
        "default": "./dist/cjs/html.cjs"
      }
    },
    "./source-syntax": {
      "import": {
        "types": "./dist/esm/source-syntax.d.ts",
        "default": "./dist/esm/source-syntax.js"
      },
      "require": {
        "types": "./dist/cjs/source-syntax.d.cts",
        "default": "./dist/cjs/source-syntax.cjs"
      }
    },
    "./source-text-buffer": {
      "import": {
