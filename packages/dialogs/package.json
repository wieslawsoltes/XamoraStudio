{
  "name": "@wieslawsoltes/xamora-dialogs",
  "version": "0.8.0",
  "description": "Standalone modal dialogs with focus ownership and asynchronous action lifecycle",
  "type": "module",
  "license": "MIT",
  "author": "Xamora contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/XamoraStudio.git",
    "directory": "packages/dialogs"
  },
  "homepage": "https://wieslawsoltes.github.io/XamoraStudio/",
  "bugs": "https://github.com/wieslawsoltes/XamoraStudio/issues",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./dialog-host": {
      "import": {
        "types": "./dist/esm/dialog-host.d.ts",
        "default": "./dist/esm/dialog-host.js"
      },
      "require": {
        "types": "./dist/cjs/dialog-host.d.cts",
        "default": "./dist/cjs/dialog-host.cjs"
      }
    },
    "./dialog-host.css": "./dist/assets/dialog-host.css",
    "./browser": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/browser/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "node ../../scripts/build-packages.mjs"
  }
}
