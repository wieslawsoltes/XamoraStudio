{
  "name": "@wieslawsoltes/xamora-control-primitives",
  "version": "0.8.0",
  "description": "Standalone menus, scroll strips and UI density preferences",
  "type": "module",
  "license": "MIT",
  "author": "Xamora contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/XamoraStudio.git",
    "directory": "packages/control-primitives"
  },
  "homepage": "https://wieslawsoltes.github.io/XamoraStudio/",
  "bugs": "https://github.com/wieslawsoltes/XamoraStudio/issues",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./menu-bar": {
      "import": {
        "types": "./dist/esm/menu-bar.d.ts",
        "default": "./dist/esm/menu-bar.js"
      },
      "require": {
        "types": "./dist/cjs/menu-bar.d.cts",
        "default": "./dist/cjs/menu-bar.cjs"
      }
    },
    "./scroll-buttons": {
      "import": {
        "types": "./dist/esm/scroll-buttons.d.ts",
        "default": "./dist/esm/scroll-buttons.js"
      },
      "require": {
        "types": "./dist/cjs/scroll-buttons.d.cts",
        "default": "./dist/cjs/scroll-buttons.cjs"
      }
    },
    "./workspace-density": {
      "import": {
        "types": "./dist/esm/workspace-density.d.ts",
        "default": "./dist/esm/workspace-density.js"
      },
      "require": {
        "types": "./dist/cjs/workspace-density.d.cts",
        "default": "./dist/cjs/workspace-density.cjs"
      }
    },
    "./scroll-buttons.css": "./dist/assets/scroll-buttons.css",
    "./menu-bar.css": "./dist/assets/menu-bar.css",
    "./browser": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./document-scope": {
      "import": {
        "types": "./dist/esm/document-scope.d.ts",
        "default": "./dist/esm/document-scope.js"
      },
      "require": {
        "types": "./dist/cjs/document-scope.d.cts",
        "default": "./dist/cjs/document-scope.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "node ../../scripts/build-packages.mjs"
  }
}
