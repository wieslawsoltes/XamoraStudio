{
  "name": "@wieslawsoltes/xamora-code-editor",
  "version": "0.8.0",
  "description": "Standalone source editor with injectable language services and buffer history",
  "type": "module",
  "license": "MIT",
  "author": "Xamora contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/XamoraStudio.git",
    "directory": "packages/code-editor"
  },
  "homepage": "https://wieslawsoltes.github.io/XamoraStudio/",
  "bugs": "https://github.com/wieslawsoltes/XamoraStudio/issues",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./code-editor": {
      "import": {
        "types": "./dist/esm/code-editor.d.ts",
        "default": "./dist/esm/code-editor.js"
      },
      "require": {
        "types": "./dist/cjs/code-editor.d.cts",
        "default": "./dist/cjs/code-editor.cjs"
      }
    },
    "./code-viewport": {
      "import": {
        "types": "./dist/esm/code-viewport.d.ts",
        "default": "./dist/esm/code-viewport.js"
      },
      "require": {
        "types": "./dist/cjs/code-viewport.d.cts",
        "default": "./dist/cjs/code-viewport.cjs"
      }
    },
    "./code-editor.css": "./dist/assets/code-editor.css",
    "./browser": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./text-search": {
      "import": {
        "types": "./dist/esm/text-search.d.ts",
        "default": "./dist/esm/text-search.js"
      },
      "require": {
        "types": "./dist/cjs/text-search.d.cts",
        "default": "./dist/cjs/text-search.cjs"
      }
    },
    "./editor-search": {
      "import": {
        "types": "./dist/esm/editor-search.d.ts",
        "default": "./dist/esm/editor-search.js"
      },
      "require": {
        "types": "./dist/cjs/editor-search.d.cts",
        "default": "./dist/cjs/editor-search.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "node ../../scripts/build-packages.mjs"
  }
}
